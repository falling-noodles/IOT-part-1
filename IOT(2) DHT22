#include <WiFi.h>
#include <PubSubClient.h>
#include "DHT.h"
#include "time.h" // Built-in library to handle NTP time fetch

// Wi-Fi Credentials
const char* ssid = "TECNO CAMON 40 Pro 5G";
const char* password = "santrifiwa";

// Mosquitto Broker Settings
const char* mqtt_server = "test.mosquitto.org";
const int mqtt_port = 1883;
const char* mqtt_topic = "IhateHERIZONS";

// Hardware Pin Configuration
#define DHTPIN 14
#define DHTTYPE DHT22

// NTP Server Settings
const char* ntpServer = "pool.ntp.org";
// Adjust time zone offset in seconds (e.g., UTC+7 for Western Indonesian Time = 7 * 3600 = 25200)
const long  gmtOffset_sec = 25200; 
const int   daylightOffset_sec = 0; // Set to 3600 if your region observes Daylight Saving Time

WiFiClient espClient;
PubSubClient client(espClient);
DHT dht(DHTPIN, DHTTYPE);

// Periodic telemetry timer
unsigned long lastDHTReadTime = 0;
const unsigned long dhtInterval = 1000; // Read sensor every 5 seconds

// Function to fetch the current time as a formatted string
String getFormattedTime() {
  struct tm timeinfo;
  if(!getLocalTime(&timeinfo)){
    return "N/A";
  }
  char timeStringBuff[50];
  // Formats time as: YYYY-MM-DD HH:MM:SS
  strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%d %H:%M:%S", &timeinfo);
  return String(timeStringBuff);
}

void setup_wifi() {
  delay(10);
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());
}

void reconnect() {
  while (!client.connected()) {
    Serial.print("Connecting to Mosquitto Broker...");
    // Dynamic Client ID to prevent disconnect conflicts on public broker
    String clientId = "ESP32_Arza_" + String(random(0xffff), HEX);
    
    if (client.connect(clientId.c_str())) {
      Serial.println(" CONNECTED!");
    } else {
      Serial.print(" Failed, rc=");
      Serial.print(client.state());
      Serial.println(" (Retrying in 5s...)");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  
  // Initialize DHT22 Sensor
  dht.begin();
  
  // Connect Wi-Fi
  setup_wifi();
  
  // Initialize and configure time from NTP server
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
  Serial.println("Retrieving time from NTP server...");
  
  // Set MQTT Server
  client.setServer(mqtt_server, mqtt_port);
}

void loop() {
  // Ensure MQTT connection stays active
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  // Periodic DHT22 Telemetry (Every 5 Seconds)
  unsigned long now = millis();
  if (now - lastDHTReadTime > dhtInterval) {
    lastDHTReadTime = now;

    float humidity = dht.readHumidity();
    float temperature = dht.readTemperature();
    
    // Get the exact time of measurement
    String currentTime = getFormattedTime();

    if (!isnan(humidity) && !isnan(temperature)) {
      // JSON Payload including the timestamp
      String payload = "{\"temperature\":" + String(temperature, 1) + 
                       ",\"humidity\":" + String(humidity, 1) + 
                       ",\"time\":\"" + currentTime + "\"}";

      // Display tracking details clearly in the Serial Monitor
      Serial.print("[");
      Serial.print(currentTime);
      Serial.print("] Publishing to [");
      Serial.print(mqtt_topic);
      Serial.print("]: ");
      Serial.println(payload);

      client.publish(mqtt_topic, payload.c_str());
    } else {
      Serial.print("[");
      Serial.print(currentTime);
      Serial.println("] Warning: Failed to read from DHT22 sensor! Check connections.");
    }
  }
}
